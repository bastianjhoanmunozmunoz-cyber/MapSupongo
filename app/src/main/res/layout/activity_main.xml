<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent">
    <fragment android:id="@+id/map" android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent" android:layout_height="match_parent" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:padding="16dp" android:background="@android:color/transparent">
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="24dp" app:cardElevation="8dp" app:strokeColor="#E9E5DF" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RUMBO  /  BITÁCORA DE LUGARES" android:textColor="#557064" android:textSize="11sp" android:letterSpacing="0.12" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Guarda el camino." android:textColor="#1D2924" android:textSize="22sp" android:textStyle="bold" android:layout_marginTop="4dp" />
                <TextView android:id="@+id/locationText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Buscando tu ubicación…" android:textColor="#64736C" android:textSize="13sp" android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
    <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/myLocationButton"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end|center_vertical"
        android:layout_margin="18dp" android:contentDescription="Ir a mi ubicación" app:backgroundTint="#FFFFFF"
        app:srcCompat="@android:drawable/ic_menu_mylocation" app:tint="#23483A" />
    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:layout_margin="16dp" app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="24dp" app:cardElevation="10dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
            <ImageView android:id="@+id/photoPreview" android:layout_width="54dp" android:layout_height="54dp" android:scaleType="centerCrop" android:visibility="gone" android:contentDescription="Última foto" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
                <TextView android:id="@+id/placesCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 lugares guardados" android:textColor="#1D2924" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Toca el mapa para guardar un lugar" android:textColor="#748079" android:textSize="12sp" android:layout_marginTop="3dp" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/cameraButton" android:layout_width="wrap_content" android:layout_height="52dp" android:text="Foto" android:textAllCaps="false" app:cornerRadius="16dp" app:icon="@android:drawable/ic_menu_camera" app:backgroundTint="#23483A" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
